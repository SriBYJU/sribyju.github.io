rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Public Scholark reviews.
    // Reviews never store email addresses. A signed-in user owns exactly one
    // review document, keyed by Firebase UID. The admin account may remove
    // reviews for moderation.
    match /reviews/{reviewId} {
      function signedIn() {
        return request.auth != null;
      }
      function isAdmin() {
        return signedIn()
          && request.auth.token.email is string
          && request.auth.token.email.lower() == 'admin@gradescope.app';
      }
      function validMonth(value) {
        return value is string
          && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      }
      function validReviewShape() {
        return request.resource.data.keys().hasOnly([
            'displayName', 'rating', 'body', 'createdMonth', 'updatedMonth'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.displayName ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 800
          && validMonth(request.resource.data.createdMonth)
          && validMonth(request.resource.data.updatedMonth);
      }

      allow read: if true;
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && validReviewShape()
        && request.resource.data.createdMonth == request.resource.data.updatedMonth;
      allow update: if signedIn()
        && reviewId == request.auth.uid
        && validReviewShape()
        && request.resource.data.createdMonth == resource.data.createdMonth;
      allow delete: if (signedIn() && reviewId == request.auth.uid) || isAdmin();
    }

    // Email preferences — users may manage only the record matching the email
    // verified by Firebase Authentication. Admin SDK operations bypass rules.
    match /email_subscribers/{email} {
      function ownsEmailRecord() {
        return request.auth != null
          && request.auth.token.email is string
          && email == request.auth.token.email.lower();
      }
      allow read: if ownsEmailRecord();
      allow create: if ownsEmailRecord()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['email', 'name', 'subscribedAt', 'active', 'source']);
      allow update: if ownsEmailRecord()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'subscribedAt', 'unsubscribedAt', 'active', 'source']);
      // Preserve explicit unsubscribe records instead of deleting them.
      allow delete: if false;
    }
    // Email metadata (week counter) — server-side only
    match /email_meta/{docId} {
      allow read: if false;
      allow write: if false;
    }
    // Email logs — server-side only
    match /email_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
