rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function score(v) { return v == null || (v is int && v >= 0 && v <= 100); }
      function shortText(v, n) { return v is string && v.size() <= n; }
      function validVersion(v) {
        return v is map && v.keys().hasOnly(['description','position','organization','savedAt'])
          && shortText(v.description,150) && shortText(v.position,50)
          && shortText(v.organization,100) && shortText(v.savedAt,40);
      }
      function versionAt(v, i) { return v.size() <= i || validVersion(v[i]); }
      function validActivity(d) {
        return d.keys().hasOnly(['id','category','position','organization','description','notes','grades','hours','weeks','current','context','versions','updatedAt','lastGrade'])
          && shortText(d.id,80) && shortText(d.category,50)
          && shortText(d.position,50) && shortText(d.organization,100)
          && shortText(d.description,150) && shortText(d.notes,1500)
          && d.grades is list && d.grades.size() <= 5 && d.grades.hasOnly(['9','10','11','12','PG'])
          && d.hours is number && d.hours >= 0 && d.hours <= 168
          && d.weeks is number && d.weeks >= 0 && d.weeks <= 52
          && d.current is bool && d.context is list && d.context.size() <= 6
          && d.context.hasOnly(['Family responsibility / caregiving','Paid job to support family','Limited school/community resources','Rural','First-gen','Self-initiated (no program existed)'])
          && d.versions is list && d.versions.size() <= 5
          && versionAt(d.versions,0) && versionAt(d.versions,1) && versionAt(d.versions,2)
          && versionAt(d.versions,3) && versionAt(d.versions,4)
          && d.updatedAt is int
          && (!('lastGrade' in d) || (d.lastGrade is map && d.lastGrade.keys().hasOnly(['score','rubricVersion','gradedAt']) && score(d.lastGrade.score) && shortText(d.lastGrade.rubricVersion,40) && d.lastGrade.gradedAt is int));
      }
      match /activities/{activityId} {
        allow read, delete: if owner();
        allow create, update: if owner() && request.resource.data.id == activityId && validActivity(request.resource.data);
      }
      match /profile/portfolio {
        allow read, delete: if owner();
        allow create, update: if owner()
          && request.resource.data.keys().hasOnly(['score','shape','updatedAt','libraryVersion','ids','shareToken'])
          && score(request.resource.data.score) && shortText(request.resource.data.shape,30)
          && request.resource.data.updatedAt is int && request.resource.data.libraryVersion is int
          && (!('shareToken' in request.resource.data) || request.resource.data.shareToken == null || (request.resource.data.shareToken is string && request.resource.data.shareToken.matches('^[a-f0-9]{32}$')))
          && request.resource.data.ids is list && request.resource.data.ids.size() <= 10;
      }
      match /profile/essayScore {
        allow read, delete: if owner();
        allow create, update: if owner()
          && request.resource.data.keys().hasOnly(['score','subScores','rubricVersion','essayHash','promptType','gradedAt'])
          && score(request.resource.data.score)
          && request.resource.data.subScores is map
          && request.resource.data.subScores.keys().hasOnly(['Structure','Voice','Clarity','Impact'])
          && score(request.resource.data.subScores.Structure) && score(request.resource.data.subScores.Voice)
          && score(request.resource.data.subScores.Clarity) && score(request.resource.data.subScores.Impact)
          && shortText(request.resource.data.rubricVersion,60) && shortText(request.resource.data.essayHash,128)
          && shortText(request.resource.data.promptType,60) && shortText(request.resource.data.gradedAt,40);
      }
      match /profile/gradingFeedback {
        allow read, delete: if owner();
        allow create: if owner() && validFeedback();
        allow update: if owner() && validFeedback() && request.time > resource.data.updatedAt + duration.value(60,'s');
        function validFeedback() {
          return request.resource.data.keys().hasOnly(['fair','note','updatedAt','rubricVersion'])
            && request.resource.data.fair is bool && shortText(request.resource.data.note,500)
            && shortText(request.resource.data.rubricVersion,60) && request.resource.data.updatedAt == request.time;
        }
      }
      match /{subcollection}/{docId} {
        // Prevent the legacy owner wildcard from bypassing the new validations.
        allow read, write: if owner() && subcollection != 'activities'
          && !(subcollection == 'profile' && docId in ['portfolio','essayScore','gradingFeedback']);
      }
    }
    // Capability links: unguessable document IDs, no list access, revocable by owner.
    match /admissionsShares/{token} {
      allow get: if resource.data.enabled == true || (request.auth != null && request.auth.uid == resource.data.owner);
      allow list: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
      allow create, update: if request.auth != null && request.resource.data.owner == request.auth.uid
        && (!exists(/databases/$(database)/documents/admissionsShares/$(token)) || resource.data.owner == request.auth.uid)
        && token.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['owner','enabled','score','shape','items','updatedAt'])
        && request.resource.data.enabled is bool
        && (request.resource.data.score == null || (request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100))
        && request.resource.data.shape is string && request.resource.data.shape.size() <= 30
        && request.resource.data.items is string && request.resource.data.items.size() <= 12000
        && request.resource.data.updatedAt is int;
    }
    // Public Scholark reviews.
    // Reviews never store email addresses. A signed-in user owns exactly one
    // review document, keyed by Firebase UID. The admin account may remove
    // reviews for moderation.
    match /reviews/{reviewId} {
      function signedIn() {
        return request.auth != null;
      }
      function isAdmin() {
        return signedIn()
          && request.auth.token.email is string
          && request.auth.token.email.lower() == 'admin@gradescope.app';
      }
      function validMonth(value) {
        return value is string
          && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      }
      function validReviewShape() {
        return request.resource.data.keys().hasOnly([
            'displayName', 'rating', 'body', 'createdMonth', 'updatedMonth'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.displayName ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 800
          && validMonth(request.resource.data.createdMonth)
          && validMonth(request.resource.data.updatedMonth);
      }

      allow read: if true;
      allow create: if signedIn()
        && reviewId == request.auth.uid
        && validReviewShape()
        && request.resource.data.createdMonth == request.resource.data.updatedMonth;
      allow update: if signedIn()
        && reviewId == request.auth.uid
        && validReviewShape()
        && request.resource.data.createdMonth == resource.data.createdMonth;
      allow delete: if (signedIn() && reviewId == request.auth.uid) || isAdmin();
    }

    // Email preferences — users may manage only the record matching the email
    // verified by Firebase Authentication. Admin SDK operations bypass rules.
    match /email_subscribers/{email} {
      function ownsEmailRecord() {
        return request.auth != null
          && request.auth.token.email is string
          && email == request.auth.token.email.lower();
      }
      allow read: if ownsEmailRecord();
      allow create: if ownsEmailRecord()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['email', 'name', 'subscribedAt', 'active', 'source']);
      allow update: if ownsEmailRecord()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'subscribedAt', 'unsubscribedAt', 'active', 'source']);
      // Preserve explicit unsubscribe records instead of deleting them.
      allow delete: if false;
    }
    // Email metadata (week counter) — server-side only
    match /email_meta/{docId} {
      allow read: if false;
      allow write: if false;
    }
    // Email logs — server-side only
    match /email_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
